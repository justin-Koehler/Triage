APP_ENV=production
PUBLIC_BASE_URL=https://scscm.stackit.gg
POSTGRES_DB=critr
POSTGRES_USER=critr
POSTGRES_PASSWORD=replace-me
SESSION_SECRET=replace-me-long-random
SETTINGS_ENCRYPTION_KEY=
IMAGE_TAG=local
# QWEN_* unten setzt OpenAI-kompatibel; LLM_PROVIDER=openai empfohlen.
LLM_PROVIDER=openai
TICKET_PORT=fake
DEV_LOGIN_ENABLED=false
WEB_SEARCH_ENABLED=false

# Cidaas OIDC (OAuth 2.1 + PKCE). ID und Secret nur hier, nicht ins Git.
CIDAAS_DISCOVERY_URL=https://account.bildungscampus.life/.well-known/openid-configuration
CIDAAS_CLIENT_ID=
CIDAAS_CLIENT_SECRET=
# In Cidaas als Redirect URI exakt so eintragen (eine Zeile, kein Slash extra):
CIDAAS_REDIRECT_URL=https://scscm.stackit.gg/api/auth/cidaas/callback

# STACKIT Model Serving (Chat Completions). Key nur in compose.env, nicht committen.
QWEN_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3.6-27B
QWEN_TIMEOUT_MS=180000
OPENAI_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.6-27B
