LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
LLM_TIMEOUT=180

# Bootstrap — Secrets für die App, nicht fürs UI
SESSION_SECRET=dev-only-change-me
# Produktiv setzen (Fernet aus Session-Secret ableiten, wenn leer — besser explizit):
SETTINGS_ENCRYPTION_KEY=
# Bis SSO da ist: Login-Liste kommt aus Jira Assignable-Users.
DEFAULT_ACTOR_EMAIL=dev@localhost
DEFAULT_ACTOR_NAME=Dev
APP_ENV=dev
DEV_LOGIN_ENABLED=true

# Lokal SQLite; Compose/K8s: postgresql+psycopg://user:pass@host:5432/critr
DATABASE_URL=sqlite:///./data/triage.db

# optional Env-Fallback (Einstellungen-Tab überschreibt)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Keyword-Dateien und Wissensbasis. Echte Tickets: KNOWLEDGE_DIR umbiegen.
RESPONSIBLES_DIR=./config/responsibles
PRIORITY_KEYWORDS_PATH=./config/priority_keywords.md
KNOWLEDGE_DIR=./knowledge/tickets
TOPICS_DIR=./config/topics
RISKS_DIR=./config/risks
WEB_SEARCH_ENABLED=true

TICKET_PORT=fake
JIRA_BASE_URL=
JIRA_SEARCH_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_API_KEY=
JIRA_OAUTH_TOKEN_URL=
JIRA_OAUTH_AUTHORIZE_URL=
JIRA_OAUTH_REDIRECT_URL=
JIRA_OAUTH_SCOPE=
JIRA_OAUTH_AUDIENCE=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_PROJECT_KEY=CHANGE
EFFORT_SHEET_TEMPLATE_URL=
JIRA_EFFORT_SHEET_FIELD=
